function actorSnapshot(user) {
  return {
    id: user.id,
    username: user.username,
    displayName: user.displayName,
    role: user.role
  };
}

function serviceSnapshot(service) {
  if (!service) return null;
  return {
    id: service.id,
    serviceNumber: service.serviceNumber,
    name: service.name
  };
}

function createLogEntry(user, action, summary, service = null, details = {}) {
  return {
    id: crypto.randomUUID(),
    timestamp: new Date().toISOString(),
    action,
    summary,
    actor: actorSnapshot(user),
    service: serviceSnapshot(service),
    details
  };
}

function addServiceLog(service, user, action, summary, details = {}) {
  const entry = createLogEntry(user, action, summary, service, details);
  service.logs = [...(Array.isArray(service.logs) ? service.logs : []), entry];
  return entry;
}

function appendGlobalLogs(entries) {
  if (!entries.length) return;
  const data = readLogs();
  data.logs.push(...entries);
  writeLogs(data);
}

function isServiceCreator(service, user) {
  return Boolean(user && user.role !== 'visualizador' && service && service.createdBy && service.createdBy.id && service.createdBy.id === user.id);
}

function isServiceDeveloper(service, user) {
  if (!service || !user || user.role === 'visualizador') return false;
  if (service.developerAccount && service.developerAccount.id) return service.developerAccount.id === user.id;
  const developer = normalizeUsername(service.developer);
  return Boolean(developer && [user.displayName, user.username].some((name) => normalizeUsername(name) === developer));
}

function countActiveAdmins(users) {
  return users.filter((user) => user.role === 'admin' && user.active !== false).length;
}

function normalizeQueuePosition(value) {
  const position = Number(value);
  return Number.isInteger(position) && position > 0 ? position : null;
}

function serviceChronology(service) {
  const idMatch = String(service && service.id || '').match(/^SRV-(\d{8})-(\d{6})/);
  if (idMatch) return Number(idMatch[1] + idMatch[2]);
  const dateValue = service && (service.createdAt || service.orderDate);
  const timestamp = Date.parse(String(dateValue || ''));
  return Number.isNaN(timestamp) ? 0 : timestamp;
}

function getOpenQueue(services) {
  return services
    .map((service, index) => ({ service, index }))
    .filter((item) => item.service && item.service.status === 'open')
    .sort((a, b) => {
      const positionA = normalizeQueuePosition(a.service.queuePosition);
      const positionB = normalizeQueuePosition(b.service.queuePosition);
      if (positionA !== null && positionB !== null) return positionA - positionB || a.index - b.index;
      if (positionA !== null) return -1;
      if (positionB !== null) return 1;
      return serviceChronology(a.service) - serviceChronology(b.service) || a.index - b.index;
    })
    .map((item) => item.service);
}

function protectQueueOrder(previousServices, nextServices) {
  const nextById = new Map(nextServices.filter((service) => service && service.id).map((service) => [service.id, service]));
  const keptOpenIds = getOpenQueue(previousServices)
    .map((service) => service.id)
    .filter((id) => nextById.get(id) && nextById.get(id).status === 'open');
  const appendedOpenIds = nextServices
    .filter((service) => service && service.id && service.status === 'open' && !keptOpenIds.includes(service.id))
    .map((service) => service.id);
  const orderedIds = [...keptOpenIds, ...appendedOpenIds];
  const positions = new Map(orderedIds.map((id, index) => [id, index + 1]));
  return nextServices.map((service) => ({
    ...service,
    queuePosition: service && service.status === 'open' ? positions.get(service.id) || null : null
  }));
}

function makeServiceId() {
  const now = new Date();
  const stamp = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, '0'),
    String(now.getDate()).padStart(2, '0')
  ].join('');
  const time = [
    String(now.getHours()).padStart(2, '0'),
    String(now.getMinutes()).padStart(2, '0'),
    String(now.getSeconds()).padStart(2, '0')
  ].join('');
  return 'SRV-' + stamp + '-' + time + '-' + crypto.randomBytes(2).toString('hex').slice(0, 3).toUpperCase();
}

function normalizeServiceType(value) {
  const type = String(value || '').trim().toLowerCase();
  if (type.includes('faca')) return 'Criação de faca';
  if (type.includes('mock') || type.includes('mok')) return 'Mockup';
  if (type.includes('outro')) return 'Outros';
  return '';
}

function validateServicePayload(payload) {
  const name = String(payload.name || '').trim();
  const type = normalizeServiceType(payload.type);
  const orderDate = String(payload.orderDate || '').trim();
  const seller = String(payload.seller || '').trim();
  if (!name) throw new Error('Informe o nome do serviço.');
  if (!type) throw new Error('Selecione um tipo de serviço válido.');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(orderDate)) throw new Error('Informe uma data do pedido válida.');
  if (!seller) throw new Error('Informe o nome do vendedor.');
  const rawItems = Array.isArray(payload.items) ? payload.items : [];
  if (!rawItems.length) throw new Error('Adicione pelo menos um serviço ao pedido.');
  if (rawItems.length > 30) throw new Error('O pedido aceita no máximo 30 serviços.');
  const items = rawItems.map((item, index) => {
    const itemName = String(item && item.name || '').trim();
    const notes = String(item && item.notes || '').trim();
    const rollSizes = Array.isArray(item && item.rollSizes)
      ? item.rollSizes.map((size) => String(size || '').trim()).filter(Boolean)
      : [];
    if (!itemName) throw new Error('Informe o nome do serviço ' + (index + 1) + '.');
    if (!rollSizes.length) throw new Error('Adicione pelo menos um tamanho de bobina no serviço ' + (index + 1) + '.');
    if (rollSizes.length > 20) throw new Error('Cada serviço aceita no máximo 20 tamanhos de bobina.');
    if (!notes) throw new Error('Preencha as observações do serviço ' + (index + 1) + '.');
    return {
      id: String(item && item.id || crypto.randomUUID()),
      name: itemName.slice(0, 250),
      rollSizes: rollSizes.map((size) => size.slice(0, 100)),
      notes: notes.slice(0, 10000),
      attachments: [],
      completionAttachments: [],
      completed: false,
      completionNote: ''
    };
  });
  return { name: name.slice(0, 250), type, orderDate, seller: seller.slice(0, 250), items };
}

function applyItemConclusions(service, rawConclusions) {
  const items = Array.isArray(service && service.items) ? service.items : [];
  const conclusions = Array.isArray(rawConclusions) ? rawConclusions : [];
  const byId = new Map();
  conclusions.forEach((conclusion) => {
    const itemId = String(conclusion && conclusion.itemId || '');
    if (!itemId || byId.has(itemId) || typeof conclusion.completed !== 'boolean') {
      throw new Error('Revise a seleção dos serviços concluídos.');
    }
    byId.set(itemId, conclusion);
  });
  if (byId.size !== items.length) {
    throw new Error('Marque o resultado de todos os serviços do pedido.');
  }
  return items.map((item, index) => {
    const conclusion = byId.get(String(item.id));
    if (!conclusion) throw new Error('Informe o resultado do serviço ' + (index + 1) + '.');
    const completionNote = String(conclusion.note || '').trim();
    if (!conclusion.completed && !completionNote) {
      throw new Error('Informe nas observações por que o serviço ' + (index + 1) + ' não foi concluído.');
    }
    return {
      ...item,
      completed: conclusion.completed,
      completionNote: completionNote.slice(0, 5000)
    };
  });
}

function validateCompletionAttachments(service, allowLegacy = false) {
  const completedItems = (Array.isArray(service && service.items) ? service.items : []).filter((item) => item.completed);
  const hasLegacyAttachment = allowLegacy && Array.isArray(service && service.attachments) && service.attachments.length > 0;
  const missing = completedItems.filter((item) =>
    (!Array.isArray(item.completionAttachments) || !item.completionAttachments.length) && !hasLegacyAttachment
  );
  if (missing.length) {
    throw new Error('Anexe a ficha técnica ou o mockup de cada serviço concluído: ' + missing.map((item) => item.name).join(', ') + '.');
  }
}

function normalizeUsername(value) {
  return String(value || '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9._-]/g, '');
}

function hashPassword(password, salt = crypto.randomBytes(16).toString('hex')) {
  return {
    passwordSalt: salt,
    passwordHash: crypto.scryptSync(String(password), salt, 64).toString('hex')
  };
}

function passwordMatchesUser(user, password) {
  if (!user || !user.passwordSalt || !user.passwordHash) return false;
  const expected = Buffer.from(user.passwordHash, 'hex');
  const received = Buffer.from(hashPassword(password, user.passwordSalt).passwordHash, 'hex');
  return expected.length === received.length && crypto.timingSafeEqual(expected, received);
}

function createUserRecord({ username, displayName, role, password }) {
  const normalizedUsername = normalizeUsername(username);
  const normalizedRole = USER_ROLES.has(role) ? role : 'pcp';
  return {
    id: crypto.randomUUID(),
    username: normalizedUsername,
    displayName: String(displayName || normalizedUsername).trim(),
    role: normalizedRole,
    active: true,
    sessionVersion: 1,
    createdAt: new Date().toISOString(),
    ...hashPassword(password)
  };
}

function publicUser(user) {
  return {
    id: user.id,
    username: user.username,
    displayName: user.displayName,
    role: user.role,
    active: user.active !== false,
    createdAt: user.createdAt
  };
}

function base64Url(value) {
  return Buffer.from(value).toString('base64url');
}

function signTokenPart(value) {
  return crypto.createHmac('sha256', AUTH_SECRET).update(value).digest('base64url');
}

function createAccessToken(user) {
  const now = Date.now();
  const expiresAt = now + SESSION_MS;
  const payload = base64Url(JSON.stringify({
    sub: user.id,
    version: Number(user.sessionVersion || 1),
    issuedAt: now,
    expiresAt
  }));
  return { token: payload + '.' + signTokenPart(payload), expiresAt };
}

function getBearerToken(req) {
  const authorization = String(req.headers.authorization || '');
  return authorization.startsWith('Bearer ') ? authorization.slice(7).trim() : '';
}

function authenticate(req) {
  if (!AUTH_SECRET) return null;
  const token = getBearerToken(req);
  const [payloadPart, signature] = token.split('.');
  if (!payloadPart || !signature) return null;
  const expected = Buffer.from(signTokenPart(payloadPart));
  const received = Buffer.from(signature);
  if (expected.length !== received.length || !crypto.timingSafeEqual(expected, received)) return null;
  try {
    const payload = JSON.parse(Buffer.from(payloadPart, 'base64url').toString('utf8'));
    if (!payload.expiresAt || payload.expiresAt <= Date.now()) return null;
    const user = readAccounts().users.find((item) => item.id === payload.sub);
    if (!user || user.active === false || Number(user.sessionVersion || 1) !== Number(payload.version)) return null;
    return user;
  } catch {
    return null;
  }
}

function requireAuth(req, res, allowedRoles) {
  const user = authenticate(req);
  if (!user) {
    send(res, 401, JSON.stringify({ ok: false, code: 'AUTH_REQUIRED', error: 'Sua sessão expirou. Entre novamente.' }));
    return null;
  }
  if (allowedRoles && !allowedRoles.includes(user.role)) {
    send(res, 403, JSON.stringify({ ok: false, code: 'FORBIDDEN', error: 'Você não tem permissão para esta ação.' }));
    return null;
  }
  return user;
}

function reorderOpenQueue(services, orderedIds) {
  const openIds = getOpenQueue(services).map((service) => service.id);
  const requestedIds = Array.isArray(orderedIds) ? orderedIds : [];
  const validIds = requestedIds.filter((id, index) => openIds.includes(id) && requestedIds.indexOf(id) === index);
  const completeOrder = [...validIds, ...openIds.filter((id) => !validIds.includes(id))];
  const positions = new Map(completeOrder.map((id, index) => [id, index + 1]));
  return services.map((service) => service && service.status === 'open' && positions.has(service.id)
    ? { ...service, queuePosition: positions.get(service.id) }
    : service);
}

function send(res, status, body, type = 'application/json; charset=utf-8') {
  res.writeHead(status, {
    'Content-Type': type,
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    'Access-Control-Allow-Methods': 'GET, PUT, POST, DELETE, OPTIONS'
  });
  res.end(body);
}

function readBody(req, maxSize = 10000000) {
  return new Promise((resolve, reject) => {
    let body = '';
    req.on('data', (chunk) => {
      body += chunk;
      if (body.length > maxSize) reject(new Error('Payload muito grande'));
    });
    req.on('end', () => resolve(body));
    req.on('error', reject);
  });
}

function safeFileName(name) {
  return path.basename(String(name || 'anexo'))
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-zA-Z0-9._-]+/g, '_')
    .replace(/^_+|_+$/g, '') || 'anexo';
}

function originalFileName(name) {
  return path.basename(String(name || 'anexo'))
    .replace(/[\u0000-\u001f\u007f]/g, '')
    .trim()
    .slice(0, 250) || 'anexo';
}

function extensionFrom(type, name, kind) {
  const ext = path.extname(safeFileName(name)).toLowerCase();
  if (ext) return ext;
  if (kind === 'faca') return '.pdf';
  if (String(type || '').includes('pdf')) return '.pdf';
  if (String(type || '').includes('png')) return '.png';
  if (String(type || '').includes('webp')) return '.webp';
  if (String(type || '').includes('gif')) return '.gif';
  if (String(type || '').includes('image')) return '.jpg';
  return '.bin';
}

function isItemAttachmentAllowed(payload) {
  const type = String(payload && payload.fileType || '').toLowerCase();
  const ext = path.extname(safeFileName(payload && payload.fileName)).toLowerCase();
  return type === 'application/pdf'
    || type.startsWith('image/')
    || ['.pdf', '.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp', '.heic', '.heif', '.tif', '.tiff'].includes(ext);
}

function saveAttachment(service, payload) {
  const { safeId, folder } = ensureServiceFolder(service);
  const kind = ['faca', 'mockup', 'outros', 'item'].includes(payload.kind) ? payload.kind : 'anexo';
  const ext = extensionFrom(payload.fileType, payload.fileName, kind);
  const stamp = new Date().toISOString().replace(/[:.]/g, '-');
  const prefix = kind === 'faca' ? 'faca' : kind === 'mockup' ? 'mockup' : kind === 'item' ? 'servico' : 'anexo';
  const fileName = prefix + '-' + stamp + '-' + crypto.randomBytes(2).toString('hex') + ext;
  const cleanData = String(payload.data || '').split(',').pop();
  if (!cleanData) throw new Error('Arquivo vazio.');
  const fileBuffer = Buffer.from(cleanData, 'base64');
  if (!fileBuffer.length) throw new Error('Arquivo vazio.');
  if (fileBuffer.length > MAX_ATTACHMENT_FILE_BYTES) {
    throw new Error('Cada arquivo pode ter no máximo 50 MB.');
  }
  fs.writeFileSync(path.join(folder, fileName), fileBuffer);
  return {
    name: fileName,
    originalName: originalFileName(payload.fileName),
    type: payload.fileType || 'application/octet-stream',
    size: fileBuffer.length,
    kind,
    savedAt: new Date().toISOString(),
    folder: SERVICES_FOLDER + '/' + safeId,
    url: '/' + encodeURIComponent(SERVICES_FOLDER) + '/' + encodeURIComponent(safeId) + '/' + encodeURIComponent(fileName)
  };
}

function safeFile(urlPath) {
  const cleanPath = decodeURIComponent(urlPath.split('?')[0]);
  const requested = cleanPath === '/' ? '/index.html' : cleanPath;
  const filePath = path.normalize(path.join(ROOT, requested));
  if (!filePath.startsWith(ROOT)) return null;
  const relativePath = path.relative(ROOT, filePath);
  if (relativePath.split(path.sep).some((segment) => segment.startsWith('.'))) return null;
  if (relativePath.split(path.sep)[0].toLowerCase() === 'db') return null;
  if (['db.json', 'contas.json', 'servidor'].includes(relativePath.toLowerCase())) return null;
  return filePath;
}

const server = http.createServer(async (req, res) => {
  if (req.method === 'OPTIONS') return send(res, 204, '');
  const pathname = new URL(req.url || '/', 'http://localhost').pathname;

  if (pathname === '/api/auth/login' && req.method === 'POST') {
    try {
      if (!AUTH_SECRET) return send(res, 503, JSON.stringify({ ok: false, error: 'AUTH_SECRET não configurado no arquivo .env.' }));
      const body = JSON.parse(await readBody(req, 10000) || '{}');
      const username = normalizeUsername(body.username);
      const user = readAccounts().users.find((item) => item.username === username);
      if (!user || user.active === false || !passwordMatchesUser(user, body.password)) {
        return send(res, 401, JSON.stringify({ ok: false, error: 'Usuário ou senha incorretos.' }));
      }
      return send(res, 200, JSON.stringify({ ok: true, user: publicUser(user), ...createAccessToken(user) }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  if (pathname === '/api/auth/me' && req.method === 'GET') {
    const user = requireAuth(req, res);
    if (!user) return;
    return send(res, 200, JSON.stringify({ ok: true, user: publicUser(user) }));
  }

  if (pathname === '/api/config' && req.method === 'GET') {
    const user = requireAuth(req, res);
    if (!user) return;
    return send(res, 200, JSON.stringify({
      ok: true,
      whatsappOrcamento: WHATSAPP_ORCAMENTO
    }));
  }

  if (pathname === '/api/users' && req.method === 'GET') {
    const user = requireAuth(req, res, ['admin']);
    if (!user) return;
    return send(res, 200, JSON.stringify({ ok: true, users: readAccounts().users.map(publicUser) }));
  }

  if (pathname === '/api/users' && req.method === 'POST') {
    try {
      const currentUser = requireAuth(req, res, ['admin']);
      if (!currentUser) return;
      const body = JSON.parse(await readBody(req, 200000) || '{}');
      const username = normalizeUsername(body.username);
      const displayName = String(body.displayName || '').trim();
      const role = String(body.role || '');
      const password = String(body.password || '');
      if (username.length < 3) return send(res, 400, JSON.stringify({ ok: false, error: 'Informe um usuário com pelo menos 3 caracteres.' }));
      if (!displayName) return send(res, 400, JSON.stringify({ ok: false, error: 'Informe o nome do usuário.' }));
      if (!USER_ROLES.has(role)) return send(res, 400, JSON.stringify({ ok: false, error: 'Função de usuário inválida.' }));
      if (password.length < 8) return send(res, 400, JSON.stringify({ ok: false, error: 'A senha deve ter pelo menos 8 caracteres.' }));
      const accounts = readAccounts();
      if (accounts.users.some((item) => item.username === username)) return send(res, 409, JSON.stringify({ ok: false, error: 'Este usuário já existe.' }));
      const created = createUserRecord({ username, displayName, role, password });
      accounts.users.push(created);
      writeAccounts(accounts);
      appendGlobalLogs([createLogEntry(
        currentUser,
        'user_created',
        'Criou a conta de ' + created.displayName + '.',
        null,
        { userId: created.id, username: created.username, role: created.role }
      )]);
      return send(res, 201, JSON.stringify({ ok: true, user: publicUser(created) }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  const userMatch = pathname.match(/^\/api\/users\/([^/]+)$/);
  if (userMatch && req.method === 'PUT') {
    try {
      const currentUser = requireAuth(req, res, ['admin']);
      if (!currentUser) return;
      const id = decodeURIComponent(userMatch[1]);
      const body = JSON.parse(await readBody(req, 20000) || '{}');
      const accounts = readAccounts();
      const target = accounts.users.find((item) => item.id === id);
      if (!target) return send(res, 404, JSON.stringify({ ok: false, error: 'Usuário não encontrado.' }));
      const username = normalizeUsername(body.username);
      const displayName = String(body.displayName || '').trim();
      const role = String(body.role || '');
      const oldPassword = String(body.oldPassword || '');
      const newPassword = String(body.newPassword || '');
      if (username.length < 3) return send(res, 400, JSON.stringify({ ok: false, error: 'Informe um usuário com pelo menos 3 caracteres.' }));
      if (!displayName) return send(res, 400, JSON.stringify({ ok: false, error: 'Informe o nome do usuário.' }));
      if (!USER_ROLES.has(role)) return send(res, 400, JSON.stringify({ ok: false, error: 'Função de usuário inválida.' }));
      if (accounts.users.some((item) => item.id !== id && item.username === username)) {
        return send(res, 409, JSON.stringify({ ok: false, error: 'Este usuário já existe.' }));
      }
      if (target.role === 'admin' && role !== 'admin' && countActiveAdmins(accounts.users) <= 1) {
        return send(res, 400, JSON.stringify({ ok: false, error: 'Não é possível remover a função do último Admin.' }));
      }
      const changingPassword = Boolean(oldPassword || newPassword);
      if (changingPassword) {
        if (!oldPassword || !newPassword) {
          return send(res, 400, JSON.stringify({ ok: false, error: 'Para alterar a senha, informe a senha antiga e a nova senha.' }));
        }
        if (!passwordMatchesUser(target, oldPassword)) {
          return send(res, 400, JSON.stringify({ ok: false, code: 'OLD_PASSWORD_INVALID', error: 'A senha antiga está incorreta.' }));
        }
        if (newPassword.length < 8) {
          return send(res, 400, JSON.stringify({ ok: false, error: 'A nova senha deve ter pelo menos 8 caracteres.' }));
        }
        Object.assign(target, hashPassword(newPassword));
      }
      const accessChanged = target.role !== role || changingPassword;
      const previous = { username: target.username, displayName: target.displayName, role: target.role };
      target.username = username;
      target.displayName = displayName;
      target.role = role;
      target.updatedAt = new Date().toISOString();
      if (accessChanged) target.sessionVersion = Number(target.sessionVersion || 1) + 1;
      writeAccounts(accounts);
      appendGlobalLogs([createLogEntry(
        currentUser,
        'user_updated',
        'Editou a conta de ' + target.displayName + '.',
        null,
        {
          userId: target.id,
          before: previous,
          after: { username: target.username, displayName: target.displayName, role: target.role },
          passwordChanged: changingPassword
        }
      )]);
      return send(res, 200, JSON.stringify({
        ok: true,
        user: publicUser(target),
        reauthenticate: target.id === currentUser.id && accessChanged
      }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  if (userMatch && req.method === 'DELETE') {
    try {
      const currentUser = requireAuth(req, res, ['admin']);
      if (!currentUser) return;
      const id = decodeURIComponent(userMatch[1]);
      const accounts = readAccounts();
      const target = accounts.users.find((item) => item.id === id);
      if (!target) return send(res, 404, JSON.stringify({ ok: false, error: 'Usuário não encontrado.' }));
      if (target.id === currentUser.id) {
        return send(res, 400, JSON.stringify({ ok: false, error: 'Você não pode excluir sua própria conta.' }));
      }
      if (target.role === 'admin' && countActiveAdmins(accounts.users) <= 1) {
        return send(res, 400, JSON.stringify({ ok: false, error: 'Não é possível excluir o último Admin.' }));
      }
      accounts.users = accounts.users.filter((item) => item.id !== id);
      writeAccounts(accounts);
      appendGlobalLogs([createLogEntry(
        currentUser,
        'user_deleted',
        'Excluiu a conta de ' + target.displayName + '.',
        null,
        { userId: target.id, username: target.username, role: target.role }
      )]);
      return send(res, 200, JSON.stringify({ ok: true }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  if (pathname === '/api/services' && req.method === 'GET') {
    const user = requireAuth(req, res);
    if (!user) return;
    return send(res, 200, JSON.stringify({ services: readDb().services }));
  }

  if (pathname === '/api/logs' && req.method === 'GET') {
    const user = requireAuth(req, res);
    if (!user) return;
    const logs = readLogs().logs.slice().sort((a, b) => String(b.timestamp || '').localeCompare(String(a.timestamp || '')));
    return send(res, 200, JSON.stringify({ ok: true, logs }));
  }

  if (pathname === '/api/services/queue' && req.method === 'PUT') {
    try {
      const user = requireAuth(req, res);
      if (!user) return;
      if (user.role !== 'pcp') {
        return send(res, 403, JSON.stringify({ ok: false, code: 'QUEUE_PCP_ONLY', error: 'Apenas usuários com função PCP podem organizar a fila.' }));
      }
      const body = JSON.parse(await readBody(req, 100000) || '{}');
      if (!Array.isArray(body.orderedIds)) return send(res, 400, JSON.stringify({ ok: false, error: 'Ordem da fila inválida.' }));
      const db = readDb();
      const previousPositions = new Map(db.services.map((service) => [service.id, service.queuePosition]));
      db.services = reorderOpenQueue(db.services, body.orderedIds);
      const entries = [];
      db.services.forEach((service) => {
        if (service.status !== 'open') return;
        const previousPosition = previousPositions.get(service.id);
        if (previousPosition === service.queuePosition) return;
        entries.push(addServiceLog(
          service,
          user,
          'queue_reordered',
          'Alterou a posição do serviço na fila.',
          { from: previousPosition, to: service.queuePosition }
        ));
      });
      writeDb(db);
      appendGlobalLogs(entries);
      return send(res, 200, JSON.stringify({ ok: true, services: db.services }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  if (pathname === '/api/services' && req.method === 'POST') {
    try {
      const user = requireAuth(req, res, [...SERVICE_CREATE_ROLES]);
      if (!user) return;
      const payload = validateServicePayload(JSON.parse(await readBody(req, 100000) || '{}'));
      const db = readDb();
      const id = makeServiceId();
      const now = new Date();
      const service = {
        id,
        folder: SERVICES_FOLDER + '/' + String(db.nextServiceNumber).padStart(4, '0'),
        ...payload,
        createdAt: now.toISOString().slice(0, 10),
        createdAtTimestamp: now.toISOString(),
        createdBy: actorSnapshot(user),
        requesterAccount: actorSnapshot(user),
        requester: String(user.displayName || user.username || '').trim(),
        source: '',
        notes: '',
        developer: '',
        deletedReason: '',
        deletedAt: '',
        completedAt: '',
        completionMessage: '',
        attachments: [],
        status: 'open',
        queuePosition: getOpenQueue(db.services).length + 1,
        serviceNumber: db.nextServiceNumber,
        logs: []
      };
      const entry = addServiceLog(service, user, 'service_created', 'Criou o serviço.', { fields: payload });
      db.services.push(service);
      db.nextServiceNumber += 1;
      writeDb(db);
      appendGlobalLogs([entry]);
      return send(res, 201, JSON.stringify({ ok: true, service, services: db.services }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  const serviceMatch = pathname.match(/^\/api\/services\/([^/]+)$/);
  if (serviceMatch && req.method === 'PUT') {
    try {
      const user = requireAuth(req, res);
      if (!user) return;
      const id = decodeURIComponent(serviceMatch[1]);
      const payload = validateServicePayload(JSON.parse(await readBody(req, 100000) || '{}'));
      const db = readDb();
      const serviceIndex = db.services.findIndex((service) => service && service.id === id);
      if (serviceIndex < 0) return send(res, 404, JSON.stringify({ ok: false, error: 'Serviço não encontrado.' }));
      const service = db.services[serviceIndex];
      if (service.status !== 'open') {
        return send(res, 409, JSON.stringify({ ok: false, error: 'Somente serviços abertos podem ser editados.' }));
      }
      if (!SERVICE_EDIT_ROLES.has(user.role) && !isServiceCreator(service, user)) {
        return send(res, 403, JSON.stringify({ ok: false, error: 'Apenas quem criou o serviço, o Gerente, o Supervisor ou o Admin pode editá-lo.' }));
      }
      const previousItems = new Map(
        (Array.isArray(service.items) ? service.items : []).map((item) => [String(item.id), item])
      );
      payload.items = payload.items.map((item) => ({
        ...item,
        attachments: Array.isArray(previousItems.get(String(item.id))?.attachments)
          ? previousItems.get(String(item.id)).attachments
          : [],
        completionAttachments: Array.isArray(previousItems.get(String(item.id))?.completionAttachments)
          ? previousItems.get(String(item.id)).completionAttachments
          : []
      }));
      const changedFields = {};
      Object.entries(payload).forEach(([field, value]) => {
        if (service[field] !== value) changedFields[field] = { from: service[field], to: value };
      });
      Object.assign(service, payload, { updatedAt: new Date().toISOString() });
      const entries = [];
      if (Object.keys(changedFields).length) {
        entries.push(addServiceLog(service, user, 'service_updated', 'Editou os dados do serviço.', { changes: changedFields }));
      }
      writeDb(db);
      appendGlobalLogs(entries);
      return send(res, 200, JSON.stringify({ ok: true, service, services: db.services }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  const statusMatch = pathname.match(/^\/api\/services\/([^/]+)\/status$/);
  if (statusMatch && req.method === 'PUT') {
    try {
      const user = requireAuth(req, res);
      if (!user) return;
      const id = decodeURIComponent(statusMatch[1]);
      const body = JSON.parse(await readBody(req, 200000) || '{}');
      const nextStatus = String(body.status || '');
      const allowedStatuses = new Set(['open', 'development', 'done', 'deleted']);
      if (!allowedStatuses.has(nextStatus)) {
        return send(res, 400, JSON.stringify({ ok: false, error: 'Status do serviço inválido.' }));
      }
      const db = readDb();
      const serviceIndex = db.services.findIndex((service) => service && service.id === id);
      if (serviceIndex < 0) {
        return send(res, 404, JSON.stringify({ ok: false, error: 'Serviço não encontrado.' }));
      }
      const currentService = db.services[serviceIndex];
      const previousStatus = currentService.status;
      const creator = isServiceCreator(currentService, user);
      if (nextStatus === 'deleted') {
        if (currentService.status === 'deleted') {
          return send(res, 409, JSON.stringify({ ok: false, error: 'O serviço já está deletado.' }));
        }
        if (!SERVICE_DELETE_ROLES.has(user.role) && !creator) {
          return send(res, 403, JSON.stringify({ ok: false, error: 'Apenas o PCP, Gerente, Supervisor, Admin ou quem criou o serviço pode excluí-lo.' }));
        }
      } else if (currentService.status === 'deleted') {
        if (nextStatus !== 'open' || user.role !== 'admin') {
          return send(res, 403, JSON.stringify({ ok: false, error: 'Apenas o Admin pode restaurar serviços deletados.' }));
        }
      } else {
        if (!SERVICE_WORKFLOW_ROLES.has(user.role)) {
          return send(res, 403, JSON.stringify({ ok: false, error: 'Apenas usuários Desenvolvedores ou Admin podem alterar o andamento do serviço.' }));
        }
        const workflowTransitions = {
          open: new Set(['development']),
          development: new Set(['open', 'development', 'done']),
          done: new Set(['open'])
        };
        if (!workflowTransitions[currentService.status]?.has(nextStatus)) {
          const error = currentService.status === 'open' && nextStatus === 'done'
            ? 'Um serviço aberto precisa entrar em desenvolvimento antes de ser concluído.'
            : 'Esta mudança de status não é permitida.';
          return send(res, 409, JSON.stringify({ ok: false, error }));
        }
      }

      if (user.role === 'design' && nextStatus === 'development') {
        const actorName = normalizeUsername(user.displayName || user.username);
        const activeService = db.services.find((service) => {
          if (!service || service.id === currentService.id || service.status !== 'development') return false;
          if (service.developerAccount && service.developerAccount.id) {
            return service.developerAccount.id === user.id;
          }
          return actorName && normalizeUsername(service.developer) === actorName;
        });
        if (activeService) {
          return send(res, 409, JSON.stringify({
            ok: false,
            code: 'DESIGN_ACTIVE_SERVICE_LIMIT',
            error: 'Você já está desenvolvendo outro serviço. Conclua ou devolva esse serviço para a fila antes de iniciar outro.',
            activeService: serviceSnapshot(activeService)
          }));
        }
      }

      const updatedService = { ...currentService, status: nextStatus, updatedAt: new Date().toISOString() };
      let action = 'service_status_changed';
      let summary = 'Alterou o andamento do serviço.';
      const details = { from: previousStatus, to: nextStatus };
      if (nextStatus === 'development') {
        action = previousStatus === 'development' ? 'development_assigned' : 'development_started';
        summary = previousStatus === 'development' ? 'Assumiu o desenvolvimento do serviço.' : 'Iniciou o desenvolvimento do serviço.';
        updatedService.developer = String(user.displayName || user.username || '').trim();
        updatedService.developerAccount = actorSnapshot(user);
        updatedService.deletedReason = '';
        updatedService.deletedAt = '';
        details.developer = updatedService.developer;
      }
      if (nextStatus === 'open') {
        action = previousStatus === 'deleted' ? 'service_restored' : 'service_reopened';
        summary = previousStatus === 'deleted' ? 'Restaurou o serviço deletado.' : 'Voltou o serviço para abertos.';
        updatedService.developer = '';
        updatedService.developerAccount = null;
        updatedService.deletedReason = '';
        updatedService.deletedAt = '';
        updatedService.completedAt = '';
        updatedService.completionMessage = '';
        updatedService.items = (Array.isArray(updatedService.items) ? updatedService.items : []).map((item) => ({
          ...item,
          completed: false,
          completionNote: ''
        }));
      }
      if (nextStatus === 'done') {
        const completionMessage = String(body.completionMessage || '').trim();
        if (!completionMessage) {
          return send(res, 400, JSON.stringify({ ok: false, error: 'Informe a mensagem do desenvolvedor.' }));
        }
        action = 'service_completed';
        summary = 'Concluiu o serviço.';
        updatedService.completedAt = new Date().toISOString().slice(0, 10);
        updatedService.completionMessage = completionMessage.slice(0, 5000);
        updatedService.items = applyItemConclusions(currentService, body.itemConclusions);
        validateCompletionAttachments(updatedService);
        const completedItems = updatedService.items.filter((item) => item.completed);
        details.attachments = completedItems.flatMap((item) =>
          (item.completionAttachments || []).map((attachment) => ({
            itemName: item.name,
            name: attachment.name || attachment.originalName || 'Anexo'
          }))
        );
        details.completionMessage = updatedService.completionMessage;
        details.completedItems = completedItems.map((item) => item.name);
        details.notCompletedItems = updatedService.items.filter((item) => !item.completed).map((item) => ({
          name: item.name,
          reason: item.completionNote
        }));
        summary = 'Concluiu ' + completedItems.length + ' de ' + updatedService.items.length + ' serviços do pedido.';
      }
      if (nextStatus === 'deleted') {
        const deletedReason = String(body.deletedReason || '').trim();
        if (!deletedReason) {
          return send(res, 400, JSON.stringify({ ok: false, error: 'Informe o motivo da exclusão.' }));
        }
        action = 'service_deleted';
        summary = 'Excluiu o serviço.';
        updatedService.developer = '';
        updatedService.developerAccount = null;
        updatedService.deletedReason = deletedReason;
        updatedService.deletedAt = new Date().toISOString().slice(0, 10);
        details.reason = deletedReason;
      }

      const entry = addServiceLog(updatedService, user, action, summary, details);
      const nextServices = db.services.map((service, index) => index === serviceIndex ? updatedService : service);
      db.services = protectQueueOrder(db.services, nextServices);
      writeDb(db);
      appendGlobalLogs([entry]);
      return send(res, 200, JSON.stringify({ ok: true, services: db.services }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  const uploadMatch = pathname.match(/^\/api\/services\/([^/]+)\/attachment$/);
  const completionMatch = pathname.match(/^\/api\/services\/([^/]+)\/completion$/);
  if (completionMatch && req.method === 'PUT') {
    try {
      const user = requireAuth(req, res);
      if (!user) return;
      const id = decodeURIComponent(completionMatch[1]);
      const body = JSON.parse(await readBody(req, 200000) || '{}');
      const db = readDb();
      const service = db.services.find((item) => item && item.id === id);
      if (!service) return send(res, 404, JSON.stringify({ ok: false, error: 'Serviço não encontrado.' }));
      if (service.status !== 'done') {
        return send(res, 409, JSON.stringify({ ok: false, error: 'Somente serviços concluídos podem ter a conclusão editada.' }));
      }
      if (user.role !== 'admin' && !isServiceDeveloper(service, user)) {
        return send(res, 403, JSON.stringify({ ok: false, error: 'Apenas o desenvolvedor responsável ou o Admin pode editar a conclusão.' }));
      }
      const completionMessage = String(body.completionMessage || '').trim();
      if (!completionMessage) return send(res, 400, JSON.stringify({ ok: false, error: 'Informe a mensagem do desenvolvedor.' }));
      service.completionMessage = completionMessage.slice(0, 5000);
      service.items = applyItemConclusions(service, body.itemConclusions);
      validateCompletionAttachments(service, true);
      service.updatedAt = new Date().toISOString();
      const completedItems = service.items.filter((item) => item.completed);
      const entry = addServiceLog(service, user, 'service_completion_updated', 'Editou os resultados, a mensagem ou os arquivos da conclusão.', {
        completionMessage: service.completionMessage,
        attachments: completedItems.flatMap((item) =>
          (item.completionAttachments || []).map((attachment) => ({
            itemName: item.name,
            name: attachment.originalName || attachment.name
          }))
        ),
        completedItems: completedItems.map((item) => item.name),
        notCompletedItems: service.items.filter((item) => !item.completed).map((item) => ({
          name: item.name,
          reason: item.completionNote
        }))
      });
      writeDb(db);
      appendGlobalLogs([entry]);
      return send(res, 200, JSON.stringify({ ok: true, service, services: db.services }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  const deleteAttachmentMatch = pathname.match(/^\/api\/services\/([^/]+)\/attachment\/([^/]+)$/);
  if (deleteAttachmentMatch && req.method === 'DELETE') {
    try {
      const user = requireAuth(req, res);
      if (!user) return;
      const id = decodeURIComponent(deleteAttachmentMatch[1]);
      const attachmentName = path.basename(decodeURIComponent(deleteAttachmentMatch[2]));
      const db = readDb();
      const service = db.services.find((item) => item && item.id === id);
      if (!service) return send(res, 404, JSON.stringify({ ok: false, error: 'Serviço não encontrado.' }));
      let targetItem = null;
      let attachmentScope = 'legacy-completion';
      let attachment = (Array.isArray(service.attachments) ? service.attachments : []).find((item) => item.name === attachmentName);
      if (!attachment) {
        targetItem = (Array.isArray(service.items) ? service.items : []).find((item) =>
          (Array.isArray(item.attachments) ? item.attachments : []).some((file) => file.name === attachmentName)
        );
        attachment = targetItem && targetItem.attachments.find((file) => file.name === attachmentName);
        if (attachment) attachmentScope = 'request';
      }
      if (!attachment) {
        targetItem = (Array.isArray(service.items) ? service.items : []).find((item) =>
          (Array.isArray(item.completionAttachments) ? item.completionAttachments : []).some((file) => file.name === attachmentName)
        );
        attachment = targetItem && targetItem.completionAttachments.find((file) => file.name === attachmentName);
        if (attachment) attachmentScope = 'completion';
      }
      if (!attachment) return send(res, 404, JSON.stringify({ ok: false, error: 'Anexo não encontrado.' }));
      if (attachmentScope === 'request') {
        if (service.status !== 'open' || (!SERVICE_EDIT_ROLES.has(user.role) && !isServiceCreator(service, user))) {
          return send(res, 403, JSON.stringify({ ok: false, error: 'Este anexo só pode ser removido durante a edição do pedido aberto.' }));
        }
        targetItem.attachments = targetItem.attachments.filter((file) => file.name !== attachmentName);
      } else if (attachmentScope === 'completion') {
        const canEditDone = service.status === 'done' && (user.role === 'admin' || isServiceDeveloper(service, user));
        const canEditDevelopment = service.status === 'development' && SERVICE_WORKFLOW_ROLES.has(user.role);
        if (!canEditDone && !canEditDevelopment) {
          return send(res, 403, JSON.stringify({ ok: false, error: 'Apenas o desenvolvedor responsável ou o Admin pode remover este arquivo da conclusão.' }));
        }
        targetItem.completionAttachments = targetItem.completionAttachments.filter((file) => file.name !== attachmentName);
      } else {
        const canEditDone = service.status === 'done' && (user.role === 'admin' || isServiceDeveloper(service, user));
        const canEditDevelopment = service.status === 'development' && SERVICE_WORKFLOW_ROLES.has(user.role);
        if (!canEditDone && !canEditDevelopment) {
          return send(res, 403, JSON.stringify({ ok: false, error: 'Você não tem permissão para remover este anexo.' }));
        }
        service.attachments = service.attachments.filter((file) => file.name !== attachmentName);
      }
      const folderPath = path.join(SERVICES_DIR, serviceFolderName(service));
      const filePath = path.join(folderPath, attachmentName);
      if (filePath.startsWith(folderPath + path.sep) && fs.existsSync(filePath) && fs.statSync(filePath).isFile()) {
        fs.unlinkSync(filePath);
      }
      service.updatedAt = new Date().toISOString();
      const entry = addServiceLog(service, user, 'attachment_removed', attachmentScope === 'request'
        ? 'Removeu um anexo de entrada do serviço "' + targetItem.name + '".'
        : attachmentScope === 'completion'
          ? 'Removeu um arquivo da conclusão do serviço "' + targetItem.name + '".'
          : 'Removeu um anexo antigo da conclusão.', {
        originalName: attachment.originalName || attachment.name,
        itemId: targetItem ? targetItem.id : null,
        itemName: targetItem ? targetItem.name : null,
        scope: attachmentScope
      });
      writeDb(db);
      appendGlobalLogs([entry]);
      return send(res, 200, JSON.stringify({ ok: true, service, services: db.services }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  if (uploadMatch && req.method === 'POST') {
    try {
      const user = requireAuth(req, res);
      if (!user) return;
      const id = decodeURIComponent(uploadMatch[1]);
      const db = readDb();
      const service = db.services.find((item) => item && item.id === id);
      if (!service) return send(res, 404, JSON.stringify({ ok: false, error: 'Serviço não encontrado' }));
      if (service.status === 'deleted') {
        return send(res, 403, JSON.stringify({ ok: false, error: 'Não é possível anexar arquivos a um serviço deletado.' }));
      }
      const body = await readBody(req, 120000000);
      const payload = JSON.parse(body || '{}');
      const itemId = String(payload.itemId || '').trim();
      const attachmentScope = payload.scope === 'completion' ? 'completion' : 'request';
      if (!itemId) {
        return send(res, 400, JSON.stringify({ ok: false, error: 'Selecione a qual serviço interno este arquivo pertence.' }));
      }
      const targetItem = (Array.isArray(service.items) ? service.items : []).find((item) => String(item.id) === itemId);
      if (!targetItem) {
        return send(res, 404, JSON.stringify({ ok: false, error: 'Item do serviço não encontrado.' }));
      }
      if (attachmentScope === 'request') {
        if (service.status !== 'open') {
          return send(res, 409, JSON.stringify({ ok: false, error: 'Arquivos dos itens só podem ser alterados enquanto o pedido estiver aberto.' }));
        }
        if (!SERVICE_EDIT_ROLES.has(user.role) && !isServiceCreator(service, user)) {
          return send(res, 403, JSON.stringify({ ok: false, error: 'Apenas quem criou o pedido, o Gerente, o Supervisor ou o Admin pode anexar arquivos aos serviços.' }));
        }
        if (!isItemAttachmentAllowed(payload)) {
          return send(res, 400, JSON.stringify({ ok: false, error: 'Neste campo são permitidos apenas arquivos PDF ou imagens.' }));
        }
        payload.kind = 'item';
      } else {
        const canUploadDevelopment = service.status === 'development' && SERVICE_WORKFLOW_ROLES.has(user.role);
        const canUploadCompleted = service.status === 'done' && (user.role === 'admin' || isServiceDeveloper(service, user));
        if (!canUploadDevelopment && !canUploadCompleted) {
          return send(res, 403, JSON.stringify({ ok: false, error: 'O anexo de conclusão só pode ser enviado durante o desenvolvimento ou editado pelo responsável após a conclusão.' }));
        }
        if (!isItemAttachmentAllowed(payload)) {
          return send(res, 400, JSON.stringify({ ok: false, error: 'Na conclusão são permitidos apenas arquivos PDF ou imagens.' }));
        }
      }
      const attachment = saveAttachment(service, payload);
      attachment.uploadedBy = actorSnapshot(user);
      attachment.itemId = itemId;
      attachment.scope = attachmentScope;
      if (attachmentScope === 'completion') {
        targetItem.completionAttachments = [...(Array.isArray(targetItem.completionAttachments) ? targetItem.completionAttachments : []), attachment];
      } else {
        targetItem.attachments = [...(Array.isArray(targetItem.attachments) ? targetItem.attachments : []), attachment];
      }
      service.updatedAt = new Date().toISOString();
      const entry = addServiceLog(service, user, 'attachment_added', attachmentScope === 'completion'
        ? 'Adicionou um arquivo à conclusão do serviço "' + targetItem.name + '".'
        : 'Adicionou um anexo de entrada ao serviço "' + targetItem.name + '".', {
        name: attachment.name,
        originalName: attachment.originalName,
        kind: attachment.kind,
        itemId,
        itemName: targetItem.name,
        scope: attachmentScope
      });
      writeDb(db);
      appendGlobalLogs([entry]);
      return send(res, 200, JSON.stringify({ ok: true, attachment, service, services: db.services }));
    } catch (error) {
      return send(res, 400, JSON.stringify({ ok: false, error: error.message }));
    }
  }

  const filePath = safeFile(req.url || '/');
  if (!filePath || !fs.existsSync(filePath) || fs.statSync(filePath).isDirectory()) {
    return send(res, 404, 'Arquivo não encontrado', 'text/plain; charset=utf-8');
  }

  const type = MIME[path.extname(filePath).toLowerCase()] || 'application/octet-stream';
  res.writeHead(200, { 'Content-Type': type });
  fs.createReadStream(filePath).pipe(res);
});

function printAccessUrls(port) {
  const ips = getNetworkIps();
  console.log('Sistema rodando em http://localhost:' + port);
  if (ips.length) {
    console.log('Abrir em outros computadores da rede:');
    ips.forEach((ip) => console.log('  http://' + ip + ':' + port));
  } else {
    console.log('Não foi possível detectar o IP da rede. Use ipconfig para consultar.');
  }
  console.log('Serviços salvos em: ' + SERVICES_DB_FILE);
  console.log('Contas salvas em: ' + ACCOUNTS_FILE);
  console.log('Configurações salvas em: ' + SETTINGS_FILE);
  console.log('Logs salvos em: ' + LOGS_FILE);
  console.log('Anexos salvos em: ' + SERVICES_DIR);
  console.log(AUTH_SECRET ? 'Acesso protegido por login, com sessão válida por 2 horas.' : 'ATENÇÃO: defina AUTH_SECRET no arquivo .env para habilitar o login.');
  if (!readAccounts().users.length) console.log('ATENÇÃO: nenhuma conta foi encontrada em contas.json.');
}

server.on('error', (error) => {
  if (error.code === 'EADDRINUSE') {
    console.log('');
    console.log('A porta ' + PORT + ' já está em uso.');
    console.log('Provavelmente o sistema já está aberto em outra janela.');
    console.log('Acesse: http://localhost:' + PORT);
    console.log('Para reiniciar, feche a outra janela do servidor ou pressione Ctrl+C nela.');
    return;
  }
  throw error;
});

ensureDataFiles();
writeDb(readDb());
server.listen(PORT, '0.0.0.0', () => printAccessUrls(PORT));
