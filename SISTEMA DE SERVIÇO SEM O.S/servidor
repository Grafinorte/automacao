function loadEnvFile(filePath) {
  if (!fs.existsSync(filePath)) return;
  const lines = fs.readFileSync(filePath, 'utf8').split(/\r?\n/);
  lines.forEach((line) => {
    const match = line.match(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$/);
    if (!match || line.trim().startsWith('#') || process.env[match[1]] !== undefined) return;
    let value = match[2];
    if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) value = value.slice(1, -1);
    process.env[match[1]] = value;
  });
}

function getNetworkIps() {
  return Object.values(os.networkInterfaces())
    .flat()
    .filter((item) => item && item.family === 'IPv4' && !item.internal)
    .map((item) => item.address);
}

function safeServiceId(id) {
  return String(id || '').replace(/[^a-zA-Z0-9_-]/g, '_') || 'sem-id';
}

function ensureServicesDir() {
  if (!fs.existsSync(SERVICES_DIR)) fs.mkdirSync(SERVICES_DIR, { recursive: true });
}

function serviceFolderName(service) {
  const number = Number(service && service.serviceNumber);
  if (Number.isInteger(number) && number > 0) return String(number).padStart(4, '0');
  return safeServiceId(service && service.id);
}

function ensureServiceFolder(service) {
  ensureServicesDir();
  const safeId = serviceFolderName(service);
  const folder = path.join(SERVICES_DIR, safeId);
  if (!fs.existsSync(folder)) fs.mkdirSync(folder, { recursive: true });
  return { safeId, folder };
}

function updateAttachmentFolder(attachment, folderName) {
  if (!attachment || !attachment.name) return attachment;
  attachment.folder = SERVICES_FOLDER + '/' + folderName;
  attachment.url = '/' + encodeURIComponent(SERVICES_FOLDER) + '/' + encodeURIComponent(folderName) + '/' + encodeURIComponent(attachment.name);
  return attachment;
}

function mergeFolderContents(source, target) {
  fs.readdirSync(source, { withFileTypes: true }).forEach((entry) => {
    const sourcePath = path.join(source, entry.name);
    let targetPath = path.join(target, entry.name);
    if (fs.existsSync(targetPath)) {
      const ext = path.extname(entry.name);
      const base = path.basename(entry.name, ext);
      targetPath = path.join(target, base + '-migrado-' + crypto.randomBytes(2).toString('hex') + ext);
    }
    fs.renameSync(sourcePath, targetPath);
  });
  fs.rmdirSync(source);
}

function ensureServiceFolders(services) {
  ensureServicesDir();
  const activeFolderNames = new Set();
  services.forEach((service) => {
    if (!service || !service.id) return;
    const folderName = serviceFolderName(service);
    activeFolderNames.add(folderName);
    const target = path.join(SERVICES_DIR, folderName);
    const storedFolderName = String(service.folder || '').split(/[\\/]/).filter(Boolean).pop();
    const candidates = [...new Set([storedFolderName, safeServiceId(service.id)].filter(Boolean))]
      .filter((candidate) => candidate !== folderName)
      .map((candidate) => path.join(SERVICES_DIR, candidate))
      .filter((candidate) => fs.existsSync(candidate) && fs.statSync(candidate).isDirectory());
    if (!fs.existsSync(target) && candidates.length) {
      fs.renameSync(candidates.shift(), target);
    }
    if (!fs.existsSync(target)) fs.mkdirSync(target, { recursive: true });
    candidates.forEach((source) => mergeFolderContents(source, target));
    service.folder = SERVICES_FOLDER + '/' + folderName;
    (Array.isArray(service.attachments) ? service.attachments : []).forEach((attachment) => updateAttachmentFolder(attachment, folderName));
    (Array.isArray(service.items) ? service.items : []).forEach((item) => {
      (Array.isArray(item.attachments) ? item.attachments : []).forEach((attachment) => updateAttachmentFolder(attachment, folderName));
      (Array.isArray(item.completionAttachments) ? item.completionAttachments : []).forEach((attachment) => updateAttachmentFolder(attachment, folderName));
    });
  });
  fs.readdirSync(SERVICES_DIR, { withFileTypes: true }).forEach((entry) => {
    if (!entry.isDirectory() || activeFolderNames.has(entry.name) || !/^SRV-/i.test(entry.name)) return;
    const orphanPath = path.join(SERVICES_DIR, entry.name);
    if (!fs.readdirSync(orphanPath).length) fs.rmdirSync(orphanPath);
  });
}

function readJsonFile(filePath, fallback) {
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf8'));
  } catch {
    return fallback;
  }
}

function writeJsonFile(filePath, data) {
  const tmp = filePath + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(data, null, 2));
  fs.renameSync(tmp, filePath);
}

function backupAndRemoveLegacy(filePath, backupName) {
  if (!fs.existsSync(filePath)) return;
  const backupPath = path.join(DB_DIR, backupName);
  if (!fs.existsSync(backupPath)) fs.copyFileSync(filePath, backupPath);
  fs.unlinkSync(filePath);
}

function ensureDataFiles() {
  if (!fs.existsSync(DB_DIR)) fs.mkdirSync(DB_DIR, { recursive: true });
  const legacyDb = readJsonFile(LEGACY_DB_FILE, {});
  const legacyAccounts = readJsonFile(LEGACY_ACCOUNTS_FILE, {});
  if (!fs.existsSync(SERVICES_DB_FILE)) {
    writeJsonFile(SERVICES_DB_FILE, { services: Array.isArray(legacyDb.services) ? legacyDb.services : [] });
  }
  if (!fs.existsSync(SETTINGS_FILE)) {
    writeJsonFile(SETTINGS_FILE, {
      nextServiceNumber: Number(legacyDb.meta && legacyDb.meta.nextServiceNumber) || 1
    });
  }
  if (!fs.existsSync(ACCOUNTS_FILE)) {
    const users = Array.isArray(legacyAccounts.users)
      ? legacyAccounts.users
      : Array.isArray(legacyDb.users) ? legacyDb.users : [];
    writeJsonFile(ACCOUNTS_FILE, { users });
  }
  if (!fs.existsSync(LOGS_FILE)) {
    writeJsonFile(LOGS_FILE, { logs: [] });
  }
  if (fs.existsSync(SERVICES_DB_FILE) && fs.existsSync(SETTINGS_FILE) && fs.existsSync(ACCOUNTS_FILE)) {
    backupAndRemoveLegacy(LEGACY_DB_FILE, 'db-raiz-legado.bak');
    backupAndRemoveLegacy(LEGACY_ACCOUNTS_FILE, 'contas-raiz-legado.bak');
  }
}

function assignServiceNumbers(services, nextNumberHint) {
  const nextServices = services.map((service) => ({ ...service }));
  const used = new Set();
  nextServices.forEach((service) => {
    const number = Number(service.serviceNumber);
    if (Number.isInteger(number) && number > 0 && !used.has(number)) {
      service.serviceNumber = number;
      used.add(number);
    } else {
      service.serviceNumber = null;
    }
  });
  const missing = nextServices
    .map((service, index) => ({ service, index }))
    .filter((item) => item.service.serviceNumber === null)
    .sort((a, b) => serviceChronology(a.service) - serviceChronology(b.service) || a.index - b.index);
  let candidate = 1;
  missing.forEach(({ service }) => {
    while (used.has(candidate)) candidate += 1;
    service.serviceNumber = candidate;
    used.add(candidate);
  });
  const highest = used.size ? Math.max(...used) : 0;
  const hinted = Number(nextNumberHint);
  return {
    services: nextServices,
    nextServiceNumber: Math.max(highest + 1, Number.isInteger(hinted) && hinted > 0 ? hinted : 1)
  };
}

function normalizeStoredAccount(account, fallbackName = '') {
  if (account && account.displayName) {
    return {
      id: account.id || null,
      username: String(account.username || ''),
      displayName: String(account.displayName || ''),
      role: String(account.role || '')
    };
  }
  const legacyName = String(fallbackName || '').trim();
  return legacyName ? { id: null, username: '', displayName: legacyName, role: '' } : null;
}

function normalizeStoredRequesterAccount(service) {
  return normalizeStoredAccount(
    service && service.requesterAccount,
    service && service.createdBy && service.createdBy.displayName
      ? service.createdBy.displayName
      : service && service.requester
  );
}

function normalizeStoredSeller(service) {
  if (typeof (service && service.seller) === 'string') {
    return String(service.seller || '').trim();
  }
  if (service && service.seller && service.seller.displayName) {
    return String(service.seller.displayName || '').trim();
  }
  return String(service && service.requester || '').trim();
}

function normalizeStoredOrderItems(service) {
  if (Array.isArray(service && service.items) && service.items.length) {
    return service.items.map((item, index) => ({
      id: String(item && item.id || 'item-' + (index + 1)),
      name: String(item && item.name || '').trim(),
      rollSizes: Array.isArray(item && item.rollSizes)
        ? item.rollSizes.map((size) => String(size || '').trim()).filter(Boolean)
        : [],
      notes: String(item && item.notes || '').trim(),
      attachments: Array.isArray(item && item.attachments) ? item.attachments : [],
      completionAttachments: Array.isArray(item && item.completionAttachments) ? item.completionAttachments : [],
      completed: typeof (item && item.completed) === 'boolean' ? item.completed : service.status === 'done',
      completionNote: String(item && item.completionNote || '').trim()
    }));
  }
  return [{
    id: 'legacy-' + safeServiceId(service && service.id),
    name: String(service && service.name || '').trim(),
    rollSizes: [],
    notes: String(service && service.notes || '').trim(),
    attachments: [],
    completionAttachments: [],
    completed: service && service.status === 'done',
    completionNote: ''
  }];
}

function normalizeDb(data) {
  const numbered = assignServiceNumbers(
    Array.isArray(data && data.services) ? data.services : [],
    data && data.nextServiceNumber
  );
  return {
    services: numbered.services.map((service) => {
      const requesterAccount = normalizeStoredRequesterAccount(service);
      const items = normalizeStoredOrderItems(service);
      let legacyCompletionAttachments = Array.isArray(service.attachments) ? service.attachments : [];
      if (service.status === 'done' && items.length === 1 && !items[0].completionAttachments.length && legacyCompletionAttachments.length) {
        items[0].completionAttachments = legacyCompletionAttachments;
        legacyCompletionAttachments = [];
      }
      return {
        ...service,
        attachments: legacyCompletionAttachments,
        createdBy: service.createdBy && service.createdBy.id ? {
        id: service.createdBy.id,
        username: String(service.createdBy.username || ''),
        displayName: String(service.createdBy.displayName || service.createdBy.username || ''),
        role: String(service.createdBy.role || '')
      } : null,
        requesterAccount,
        requester: requesterAccount ? requesterAccount.displayName : String(service.requester || '').trim(),
        seller: normalizeStoredSeller(service),
        developerAccount: normalizeStoredAccount(service.developerAccount),
        completionMessage: String(service.completionMessage || ''),
        items,
        logs: Array.isArray(service.logs) ? service.logs : []
      };
    }),
    nextServiceNumber: numbered.nextServiceNumber
  };
}

function readDb() {
  ensureDataFiles();
  const servicesData = readJsonFile(SERVICES_DB_FILE, { services: [] });
  const settings = readJsonFile(SETTINGS_FILE, { nextServiceNumber: 1 });
  return normalizeDb({ services: servicesData.services, nextServiceNumber: settings.nextServiceNumber });
}

function writeDb(data) {
  const next = normalizeDb(data);
  ensureServiceFolders(next.services);
  writeJsonFile(SERVICES_DB_FILE, { services: next.services });
  writeJsonFile(SETTINGS_FILE, { nextServiceNumber: next.nextServiceNumber });
}

function readAccounts() {
