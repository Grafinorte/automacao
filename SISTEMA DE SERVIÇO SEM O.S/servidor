  const data = readJsonFile(ACCOUNTS_FILE, { users: [] });
  return { users: Array.isArray(data.users) ? data.users : [] };
}

function writeAccounts(data) {
  const next = { users: Array.isArray(data && data.users) ? data.users : [] };
  writeJsonFile(ACCOUNTS_FILE, next);
}

function readLogs() {
  ensureDataFiles();
  const data = readJsonFile(LOGS_FILE, { logs: [] });
