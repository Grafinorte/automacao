DATABASE_URL="file:./data/grafinorte.db"
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"
PORT=4000

# Usado apenas pelo prisma/seed.ts para criar o primeiro administrador
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@grafinorte.com.br"
ADMIN_PASSWORD="troque-esta-senha-no-primeiro-acesso"

# Google Analytics 4 (aba Marketing > Site). Conta de serviço do Google Cloud com a
# "Google Analytics Data API" ativada e acesso de Leitor nas duas propriedades do GA4.
# Informe o caminho do arquivo .json da chave (fora da pasta do projeto) OU o conteúdo dele.
GA_SERVICE_ACCOUNT_FILE=""
GA_SERVICE_ACCOUNT_JSON=""
# Lista de sites/LPs (JSON numa linha só). propertyId = ID numérico da propriedade
# (GA4 > Administrador > Detalhes da propriedade). "hostname" é opcional: use quando
# várias LPs ficam na MESMA propriedade, para separar cada uma pelo domínio.
# GA_SITES='[{"key":"gn-site","label":"Site principal","group":"Grafinorte","propertyId":"111111111"},{"key":"gn-lp1","label":"LP Cartão de visita","group":"Grafinorte","propertyId":"222222222"},{"key":"pp-site","label":"Site principal","group":"Pluspack","propertyId":"333333333"}]'
GA_SITES=""
# Alternativa simples (sem LPs): um ID por empresa
GA_PROPERTY_GRAFINORTE=""
GA_PROPERTY_PLUSPACK=""

# treg (https://treg.to) — busca de empresas no Google Maps na aba Comercial › Prospecção
# Use um token de agente da equipe (treg org agent-new), não o token pessoal.
TREG_TOKEN=""
# Máximo de buscas por usuário por dia (padrão 50)
TREG_DAILY_LIMIT_PER_USER=50
# Marketing (anúncios dos concorrentes e buscas no Google): pesquisas por usuário por dia
TREG_MARKETING_DAILY_LIMIT=40
